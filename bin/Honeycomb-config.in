#! /usr/bin/env bash

# These variables need to exist
prefix=@prefix@
exec_prefix=@exec_prefix@

if [[ $# -eq 0 || -n $(echo $* | egrep -- "--help|-h") ]]; then
   echo
   echo "Honeycomb-config: configuration tool for Honeycomb: a twist-3 PDF evolution library."
   echo "                    webpage: https://github.com/QCDatHT/honeycomb"
   echo
   echo "Usage: Honeycomb-config [[--help|-h] | [--prefix] | [--ldflags]]"
   echo "Options:"
   echo "  --help | -h    : show this help message"
   echo "  --prefix       : show the installation prefix (cf. autoconf)"
   echo "  --incdir       : show the path to the Honeycomb header directory (for C interface)"
   echo "  --libdir       : show the path to the Honeycomb library directory"
   echo "  --cflags       : get compiler flags for use with the C preprocessor stage"
   echo "  --ldflags      : get compiler flags for use with the linker stage of any compilation"
fi

OUT=""

tmp=$(echo "$*" | egrep -- '--\<prefix\>')
test -n "$tmp" && OUT="$OUT @prefix@"

tmp=$(echo "$*" | egrep -- '--\<incdir\>')
test -n "$tmp" && OUT="$OUT @includedir@"

tmp=$(echo "$*" | egrep -- '--\<cflags\>')
test -n "$tmp" && OUT="$OUT -I@includedir@"

tmp=$(echo "$*" | egrep -- '--\<libdir\>')
test -n "$tmp" && OUT="$OUT @libdir@"

tmp=$(echo "$*" | egrep -- '--\<ldflags\>')
test -n "$tmp" && OUT="$OUT -L@libdir@ -lHoneycomb"

## Version
tmp=$(echo "$*" | egrep -- '--\<version\>')
test -n "$tmp" && OUT="$OUT @Honeycomb_VERSION@"

echo $OUT
